{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":enableVulnerabilityAlerts"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "labels": ["dependencies"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 8,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Group all non-major npm devDependencies together",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend devDependencies"
    },
    {
      "description": "Group .NET Microsoft.Extensions.* together",
      "matchManagers": ["nuget"],
      "matchPackagePatterns": ["^Microsoft\\.Extensions\\."],
      "groupName": "Microsoft.Extensions"
    },
    {
      "description": "Major bumps need manual review — open PR but don't auto-merge",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"],
      "automerge": false
    },
    {
      "description": "Auto-merge passing patch + dev-dep updates",
      "matchUpdateTypes": ["patch"],
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "branch"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  }
}
