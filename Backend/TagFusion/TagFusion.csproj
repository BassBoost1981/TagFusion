<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Temporarily use Exe to see console output for debugging -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <ApplicationIcon>..\..\assets\Logo.ico</ApplicationIcon>
    <AssemblyName>TagFusion</AssemblyName>
    <RootNamespace>TagFusion</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>TagFusion</Authors>
    <Description>Windows Bild-Tagging Tool mit modernem UI</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="FaceAiSharp.Bundle" Version="0.6.35" />
    <!-- Native ONNX runtime (CPU). FaceAiSharp references only the MANAGED wrapper and expects
         the app to pick the native runtime; version MUST match Microsoft.ML.OnnxRuntime.Managed.
         Native ONNX-Runtime (CPU) — FaceAiSharp bringt nur den Managed-Wrapper mit; ohne dieses
         Paket fehlt onnxruntime.dll im Publish und der App-Start crasht mit AccessViolation. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.118" />
    <PackageReference Include="System.Management" Version="8.0.0" />

  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </None>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TagFusion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\Logo.ico" Link="Logo.ico" />
    <Resource Include="..\..\assets\Logo.png" Link="Logo.png" />
  </ItemGroup>

</Project>
